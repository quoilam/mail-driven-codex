# Copy to .env, replace placeholders, and run: chmod 600 .env
MAIL_USERNAME=your-address@163.com
MAIL_AUTHORIZATION_CODE=replace-with-your-163-authorization-code
MAIL_ALLOWED_SENDER=your-address@qq.com
MAIL_RESULT_RECIPIENT=your-address@qq.com
MAIL_IMAP_HOST=imap.163.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.163.com
MAIL_SMTP_PORT=465
WORKSPACE_ROOT=~/Documents
CODEX_MODEL=gpt-6-luna
CODEX_ALLOW_MODEL_FALLBACK=false
TASK_TIMEOUT_SECONDS=3600
POLL_INTERVAL_SECONDS=30
